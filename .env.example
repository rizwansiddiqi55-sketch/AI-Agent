# Which LLM powers the tutor: groq (default) or anthropic
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high  (only used by reasoning models like gpt-oss)
GROQ_REASONING_EFFORT=low
# Recent conversation sent per request (chars) and max reply tokens; sized for the free tier
GROQ_HISTORY_CHARS=6000
GROQ_MAX_TOKENS=2048

# Anthropic Claude (only if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# EFFORT=medium

# Memory storage: Postgres if DATABASE_URL is set (e.g. Neon on Vercel), otherwise a SQLite file
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DB_PATH=tutor.db
# Passcode required by the API (strongly recommended for any public deployment; required on Vercel)
# APP_PASSCODE=choose-something-long
# Conversation history is reset (memory kept) after this many messages
MAX_HISTORY_MESSAGES=80
