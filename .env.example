# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (medium = good balance of speed and depth for voice)
EFFORT=medium
MAX_TOKENS=16000
# Server-side refusal fallback (Anthropic beta). Set to false to disable.
ENABLE_FALLBACK=true
# Memory storage: Postgres if DATABASE_URL is set (e.g. Neon on Vercel), otherwise a SQLite file
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DB_PATH=tutor.db
# Passcode required by the API (strongly recommended for any public deployment; required on Vercel)
# APP_PASSCODE=choose-something-long
# Conversation history is reset (memory kept) after this many messages
MAX_HISTORY_MESSAGES=80
